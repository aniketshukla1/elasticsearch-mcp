# Copy to .env and fill in. Read by docker compose, the tests, and agents launched with --env-file .env.
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=change-me
# Real clusters: prefer a read-only API key (see README). It is used instead of the username and password.
# ES_API_KEY=
# Only for self-signed TLS:
# ES_CA_CERT=/path/to/http_ca.crt
